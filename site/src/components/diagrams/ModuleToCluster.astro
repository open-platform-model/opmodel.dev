---
// Figure: from module to running objects (Start here overview, figure 1).
// Drawn top to bottom on a 360-unit grid so it stays legible at phone width.
// The frame and the visual language are Figure.astro and figure.css.
import Figure from './Figure.astro'

const claim =
  'A module never names Kubernetes objects. An instance of it is rendered against a platform, ' +
  'whose transformers decide which objects each component becomes. The opm CLI or the OPM ' +
  'operator applies them and records what it applied.'
---

<Figure id="mtc" title="From module to running objects" claim={claim} width={360} height={622}>

    <!-- Row 1: what the author and the deployer write -->
    <g class="card author">
      <rect x="12" y="8" width="162" height="92" rx="8"></rect>
      <text class="role" x="24" y="28">MODULE AUTHOR</text>
      <text class="title" x="24" y="50">Module</text>
      <text class="body" x="24" y="70">component <tspan class="mono">web</tspan></text>
      <text class="body" x="24" y="88">configuration schema</text>
    </g>
    <g class="card deployer">
      <rect x="186" y="8" width="162" height="92" rx="8"></rect>
      <text class="role" x="198" y="28">DEPLOYER</text>
      <text class="title" x="198" y="50">Values</text>
      <text class="body mono" x="198" y="70">replicas: 2</text>
      <text class="body" x="198" y="88">image, port, …</text>
    </g>

    <g class="flow">
      <line x1="93" y1="100" x2="93" y2="146" marker-end="url(#mtc-arrow)"></line>
      <text class="label" x="99" y="127">imported</text>
      <line x1="267" y1="100" x2="267" y2="146" marker-end="url(#mtc-arrow)"></line>
      <text class="label" x="261" y="127" text-anchor="end">set</text>
    </g>

    <!-- Row 2: the instance -->
    <g class="card deployer">
      <rect x="48" y="148" width="264" height="70" rx="8"></rect>
      <text class="role" x="60" y="168">DEPLOYER</text>
      <text class="title" x="60" y="190">Module instance</text>
      <text class="body" x="60" y="208">name · namespace</text>
    </g>

    <g class="flow">
      <line x1="180" y1="218" x2="180" y2="262" marker-end="url(#mtc-arrow)"></line>
      <text class="label" x="188" y="244">rendered against</text>
    </g>

    <!-- Row 3: the platform and its transformers -->
    <g class="card team">
      <rect x="12" y="264" width="336" height="120" rx="8"></rect>
      <text class="role" x="24" y="284">PLATFORM TEAM</text>
      <text class="title" x="24" y="306">Platform</text>
      <text class="body" x="24" y="324">catalogs supply the transformers</text>
      <rect class="chip" x="24" y="338" width="150" height="32" rx="6"></rect>
      <text class="chip-text" x="99" y="358" text-anchor="middle">Deployment transformer</text>
      <rect class="chip" x="186" y="338" width="150" height="32" rx="6"></rect>
      <text class="chip-text" x="261" y="358" text-anchor="middle">Service transformer</text>
    </g>

    <g class="flow">
      <line x1="99" y1="370" x2="99" y2="420" marker-end="url(#mtc-arrow)"></line>
      <text class="label" x="105" y="402">emits</text>
      <line x1="261" y1="370" x2="261" y2="420" marker-end="url(#mtc-arrow)"></line>
      <text class="label" x="267" y="402">emits</text>
    </g>

    <!-- Row 4: the rendered objects -->
    <g class="obj">
      <rect x="24" y="422" width="150" height="32" rx="6"></rect>
      <text x="99" y="442" text-anchor="middle">Deployment</text>
      <rect x="186" y="422" width="150" height="32" rx="6"></rect>
      <text x="261" y="442" text-anchor="middle">Service</text>
    </g>

    <g class="flow">
      <line x1="99" y1="454" x2="99" y2="530" marker-end="url(#mtc-arrow)"></line>
      <line x1="261" y1="454" x2="261" y2="530" marker-end="url(#mtc-arrow)"></line>
      <text class="label" x="180" y="480" text-anchor="middle">applied by the opm CLI</text>
      <text class="label" x="180" y="494" text-anchor="middle">or the OPM operator</text>
    </g>

    <!-- Row 5: the cluster -->
    <rect class="zone" x="12" y="506" width="336" height="108" rx="10"></rect>
    <text class="zone-label" x="24" y="524">CLUSTER</text>
    <g class="obj">
      <rect x="24" y="532" width="150" height="30" rx="6"></rect>
      <text x="99" y="551" text-anchor="middle">Deployment</text>
      <rect x="186" y="532" width="150" height="30" rx="6"></rect>
      <text x="261" y="551" text-anchor="middle">Service</text>
      <rect x="24" y="572" width="312" height="30" rx="6"></rect>
      <text x="180" y="591" text-anchor="middle">ModuleInstance · records what was applied</text>
    </g>
</Figure>

