---
// Figure: where things live (Start here overview, figure 4).
// Three places, stacked: the registry, your machine and the cluster. Every
// arrow is one command, drawn from the thing it reads to the thing it writes
// and labelled with what it moves; the operator's fetch runs down the right
// edge, past your machine.
// The frame and the visual language are Figure.astro and figure.css.
import Figure from './Figure.astro'

const claim =
  'OPM keeps things in three places: a registry, your machine and the cluster. Every command moves ' +
  'one thing between two of them. opm module init copies a template, and opm module publish uploads ' +
  'your module. opm instance init writes an instance of a published module, and opm instance apply ' +
  'deploys it. opm platform pull copies the cluster’s platform to your machine. The OPM operator ' +
  'fetches from the registry on its own.'
---

<Figure id="wtl" title="Where things live" claim={claim} width={360} height={492}>
  <!-- The registry -->
  <rect class="zone" x="8" y="8" width="344" height="84" rx="10"></rect>
  <text class="zone-label" x="20" y="26">REGISTRY</text>
  <g class="obj">
    <rect x="20" y="36" width="106" height="36" rx="6"></rect>
    <text x="73" y="58" text-anchor="middle">templates</text>
    <rect x="132" y="36" width="132" height="36" rx="6"></rect>
    <text x="198" y="58" text-anchor="middle">modules</text>
    <rect x="272" y="36" width="68" height="36" rx="6"></rect>
    <text x="306" y="58" text-anchor="middle">catalogs</text>
  </g>

  <!-- Between the registry and your machine -->
  <g class="flow">
    <line x1="116" y1="72" x2="116" y2="202" marker-end="url(#wtl-arrow)"></line>
    <text class="cmd" x="109" y="128" text-anchor="end">module init</text>
    <text class="label" x="109" y="142" text-anchor="end">a template</text>
    <line x1="140" y1="204" x2="140" y2="74" marker-end="url(#wtl-arrow)"></line>
    <text class="cmd" x="147" y="128">module publish</text>
    <text class="label" x="147" y="142">your module</text>
    <line x1="252" y1="72" x2="252" y2="202" marker-end="url(#wtl-arrow)"></line>
    <text class="cmd" x="259" y="128">instance init</text>
    <text class="label" x="259" y="142">a module</text>
  </g>

  <!-- Your machine -->
  <rect class="zone" x="8" y="176" width="304" height="140" rx="10"></rect>
  <text class="zone-label" x="20" y="194">YOUR MACHINE</text>
  <g class="card author">
    <rect x="20" y="204" width="160" height="46" rx="6"></rect>
    <text class="chip-text" x="30" y="224">module</text>
    <text class="change" x="30" y="241">source files</text>
  </g>
  <g class="card deployer">
    <rect x="196" y="204" width="104" height="46" rx="6"></rect>
    <text class="chip-text" x="206" y="224">instance</text>
    <text class="change" x="206" y="241">package</text>
  </g>
  <g class="card team">
    <rect x="20" y="258" width="160" height="46" rx="6"></rect>
    <text class="chip-text" x="30" y="278">platform</text>
    <text class="change" x="30" y="295">~/.opm, or pulled</text>
  </g>

  <!-- Between your machine and the cluster -->
  <g class="flow">
    <line x1="252" y1="250" x2="252" y2="426" marker-end="url(#wtl-arrow)"></line>
    <text class="cmd" x="245" y="352" text-anchor="end">instance apply</text>
    <text class="label" x="245" y="366" text-anchor="end">the objects</text>
    <line x1="100" y1="428" x2="100" y2="306" marker-end="url(#wtl-arrow)"></line>
    <text class="cmd" x="93" y="352" text-anchor="end">platform pull</text>
    <text class="label" x="93" y="366" text-anchor="end">the platform</text>
  </g>

  <!-- The operator fetches from the registry itself, past your machine -->
  <g class="flow">
    <line x1="346" y1="92" x2="346" y2="398" marker-end="url(#wtl-arrow)"></line>
    <text class="cmd" x="339" y="352" text-anchor="end">OPM operator</text>
    <text class="label" x="339" y="366" text-anchor="end">fetches</text>
  </g>

  <!-- The cluster -->
  <rect class="zone" x="8" y="400" width="344" height="84" rx="10"></rect>
  <text class="zone-label" x="20" y="418">CLUSTER</text>
  <g class="card team">
    <rect x="20" y="428" width="100" height="36" rx="6"></rect>
    <text class="chip-text" x="70" y="450" text-anchor="middle">Platform</text>
  </g>
  <g class="obj">
    <rect x="128" y="428" width="108" height="36" rx="6"></rect>
    <text x="182" y="450" text-anchor="middle">ModuleInstance</text>
    <rect x="244" y="428" width="96" height="36" rx="6"></rect>
    <text x="292" y="450" text-anchor="middle">your objects</text>
  </g>
</Figure>
