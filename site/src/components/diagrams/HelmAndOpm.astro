---
// Figure: Helm and OPM side by side (What OPM is, "In Kubernetes terms").
// Two columns on shared rows, so each Helm step sits beside its OPM
// counterpart: chart and module, release and instance, the cluster and its
// record. Only OPM has the platform row: in Helm the chart's templates decide
// the objects, in OPM the platform team's transformers do.
// The frame and the visual language are Figure.astro and figure.css.
import Figure from './Figure.astro'

const claim =
  'Helm and OPM both end in a Deployment and a Service, but a different role decides them. ' +
  'In Helm, the chart author writes templates that name every object. In OPM, the module names ' +
  'components, and the platform team’s transformers decide which objects each one becomes. ' +
  'Helm records a release in a Secret. OPM records an instance in a ModuleInstance.'
---

<Figure id="hao" title="Helm and OPM" claim={claim} width={360} height={586}>
  <text class="zone-label" x="8" y="18">HELM</text>
  <text class="zone-label" x="186" y="18">OPM</text>

  <!-- Row 1: what the author writes -->
  <g class="card author">
    <rect x="8" y="28" width="166" height="118" rx="8"></rect>
    <text class="role" x="20" y="48">CHART AUTHOR</text>
    <text class="title" x="20" y="70">Chart</text>
    <text class="body mono" x="20" y="90">templates/</text>
    <g class="tag">
      <rect x="20" y="98" width="106" height="18" rx="4"></rect>
      <text x="73" y="111" text-anchor="middle">deployment.yaml</text>
      <rect x="20" y="120" width="88" height="18" rx="4"></rect>
      <text x="64" y="133" text-anchor="middle">service.yaml</text>
    </g>
  </g>
  <g class="card author">
    <rect x="186" y="28" width="166" height="118" rx="8"></rect>
    <text class="role" x="198" y="48">MODULE AUTHOR</text>
    <text class="title" x="198" y="70">Module</text>
    <text class="body" x="198" y="90">component <tspan class="mono">web</tspan></text>
    <g class="tag">
      <rect x="198" y="98" width="126" height="18" rx="4"></rect>
      <text x="261" y="111" text-anchor="middle">stateless workload</text>
      <rect x="198" y="120" width="52" height="18" rx="4"></rect>
      <text x="224" y="133" text-anchor="middle">expose</text>
    </g>
  </g>

  <g class="flow">
    <line x1="30" y1="146" x2="30" y2="176" marker-end="url(#hao-arrow)"></line>
    <text class="label" x="38" y="165">installed as</text>
    <line x1="208" y1="146" x2="208" y2="176" marker-end="url(#hao-arrow)"></line>
    <text class="label" x="216" y="165">imported</text>
  </g>

  <!-- Row 2: one configured copy, in one namespace -->
  <g class="card deployer">
    <rect x="8" y="178" width="166" height="70" rx="8"></rect>
    <text class="role" x="20" y="198">DEPLOYER</text>
    <text class="title" x="20" y="220">Release</text>
    <text class="body small" x="20" y="238">name · namespace · values</text>
  </g>
  <g class="card deployer">
    <rect x="186" y="178" width="166" height="70" rx="8"></rect>
    <text class="role" x="198" y="198">DEPLOYER</text>
    <text class="title" x="198" y="220">Module instance</text>
    <text class="body small" x="198" y="238">name · namespace · values</text>
  </g>

  <!-- Row 3: only OPM has a platform; in Helm the templates render as they are -->
  <g class="flow">
    <line x1="30" y1="248" x2="30" y2="442" marker-end="url(#hao-arrow)"></line>
    <text class="cmd" x="38" y="330">helm upgrade</text>
    <text class="cmd" x="38" y="344">--install</text>
    <text class="label" x="38" y="364">renders the</text>
    <text class="label" x="38" y="378">templates</text>
    <line x1="208" y1="248" x2="208" y2="284" marker-end="url(#hao-arrow)"></line>
    <text class="label" x="216" y="270">rendered against</text>
  </g>
  <g class="card team">
    <rect x="186" y="286" width="166" height="118" rx="8"></rect>
    <text class="role" x="198" y="306">PLATFORM TEAM</text>
    <text class="title" x="198" y="328">Platform</text>
    <rect class="chip" x="195" y="340" width="148" height="24" rx="6"></rect>
    <text class="chip-text" x="269" y="356" text-anchor="middle">Deployment transformer</text>
    <rect class="chip" x="195" y="370" width="148" height="24" rx="6"></rect>
    <text class="chip-text" x="269" y="386" text-anchor="middle">Service transformer</text>
  </g>
  <g class="flow">
    <line x1="208" y1="404" x2="208" y2="442" marker-end="url(#hao-arrow)"></line>
    <text class="cmd" x="216" y="427">opm instance apply</text>
  </g>

  <!-- Row 4: the same objects, and a different record -->
  <rect class="zone" x="8" y="444" width="166" height="134" rx="10"></rect>
  <text class="zone-label" x="20" y="462">CLUSTER</text>
  <rect class="zone" x="186" y="444" width="166" height="134" rx="10"></rect>
  <text class="zone-label" x="198" y="462">CLUSTER</text>
  <g class="obj">
    <rect x="20" y="470" width="142" height="24" rx="6"></rect>
    <text x="91" y="487" text-anchor="middle">Deployment</text>
    <rect x="20" y="500" width="142" height="24" rx="6"></rect>
    <text x="91" y="517" text-anchor="middle">Service</text>
    <rect x="20" y="530" width="142" height="38" rx="6"></rect>
    <text x="91" y="546" text-anchor="middle">Secret</text>
    <text class="note" x="91" y="561" text-anchor="middle">release record</text>

    <rect x="198" y="470" width="142" height="24" rx="6"></rect>
    <text x="269" y="487" text-anchor="middle">Deployment</text>
    <rect x="198" y="500" width="142" height="24" rx="6"></rect>
    <text x="269" y="517" text-anchor="middle">Service</text>
    <rect x="198" y="530" width="142" height="38" rx="6"></rect>
    <text x="269" y="546" text-anchor="middle">ModuleInstance</text>
    <text class="note" x="269" y="561" text-anchor="middle">instance record</text>
  </g>
</Figure>
