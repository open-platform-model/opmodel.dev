---
// Adds an outdated-version notice above the page on every version but the
// latest, then renders a page's own banner as usual.
import Default from '@astrojs/starlight/components/Banner.astro'
import { currentVersion, latestVersion, versionLinks } from '../versions'

const latest = versionLinks(Astro.locals.starlightRoute.id).find((link) => link.isLatest)!
---

{
  currentVersion !== latestVersion && (
    <div class="sl-banner" data-pagefind-ignore>
      You are reading the documentation for {currentVersion}. The latest version is{' '}
      <a href={latest.href}>{latestVersion}</a>.
    </div>
  )
}
<Default />

<style>
  /* Starlight's own .sl-banner rule is scoped to its Banner component and
     misses this element, and Black does not style banners, so the rule is
     repeated here unchanged. */
  @layer starlight.core {
    .sl-banner {
      --__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
      color: var(--__sl-banner-text);
      line-height: var(--sl-line-height-headings);
      text-align: center;
      text-wrap: balance;
      box-shadow: var(--sl-shadow-sm);
    }
    .sl-banner :global(a) {
      color: var(--__sl-banner-text);
    }
  }
</style>
