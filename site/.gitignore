# Build output and Hugo's own state (anchored: a docs bundle fixture holds a
# content/resources/ directory).
public/
/resources/
.hugo_build.lock
# Inputs generated per build: git dates and the build stamp (data/opm/), the
# content mounts (config/{production,development}/), the generated reference
# (.gen/<version>/) and prepared versions (.versions/<version>/).
data/opm/
config/production/
config/development/
.gen/
.versions/
# Check output and test-site.sh's copies (.check/), screenshots (.shots/).
.check/
.shots/
