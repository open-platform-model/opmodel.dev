# Build output and Hugo's own state (anchored: a docs bundle fixture holds a
# content/resources/ directory).
public/
/resources/
.hugo_build.lock
# Inputs generated per build: the site-owned pages' dates and the build stamp
# (data/opm/), the content mounts (config/{production,development}/) and the
# section pages and version table (.gen/).
data/opm/
config/production/
config/development/
.gen/
# Retired (retire-git-pipeline, 2026-10-04): the old resolver's archives. Kept
# ignored, and removed by task clean, for one release cycle so old checkouts
# stay clean; remove both lines after.
.versions/
# Check output and test-site.sh's copies (.check/), screenshots (.shots/).
.check/
.shots/
# The pulled docs bundles and their lock (task bundles:pull; never
# committed, the build stamp records the lock) and opm-docs' blob cache.
.bundles/
.cache/
