{{- /* The Enhancements section: OPM's design record, one unversioned section
       at /enhancements/, built from the enhancements repository's section
       bundle (docs-kit C21; site/bundles.cue sections, pulled at edge to
       <bundles>/enhancements/edge/). scripts/gen-mounts.sh checks the bundle,
       writes the section page (.gen/enhancements/_index.md, from the
       bundle's content/_index.md: an adapter cannot add the empty path) and
       mounts this adapter into the default version only; the bundle's files
       are under assets/bundles/ through the catalogs mount.
       The producer built every page: it removed HTML comments and the title
       line, resolved every relative link (to /enhancements/... or to GitHub
       at the commit built), and its markup check refused raw HTML. This
       adapter rewrites nothing. It only adds what Hugo needs and the page
       dialect forbids in a bundle page: each page's url (outside every
       /<version>/ prefix, so a page keeps its URL when the default version
       changes) and its params. Per page manifest.json lists, but
       content/_index.md: the path without .md (<NNNN>/_index is the entry's
       section page); title, description and weight from the page's front
       matter (its type is dropped: the section's own layouts render it);
       the entry's header data from data/enhancements.json (the entry whose
       page, or one of whose documents' page, is this one); repoPath, the
       page's source file, for View source at the bundle's commit
       (opm/source.html); date the entry's created date, lastmod its updated
       date on the entry's page and the manifest's lastmod on a document.
       Every page is left out of llms.txt and the sitemap.
       The data is docs-kit's schema v1 or v2 (C21; gen-mounts.sh refuses
       any other). v2 adds layout (legacy or openspec) to every entry and,
       for an openspec entry, breaking, after, accepted, progress,
       capabilities and aliases, and writes supersededBy as a list. A v1
       entry has none of them and reads as layout legacy. The adapter turns
       breaking into "yes" or "no" (a boolean is falsy in a template), keeps
       supersededBy a list for both, and marks each alias target with the
       slugs it replaced (retired): custom/head-end.html publishes a redirect
       stub at each, because Hugo's own aliases land under the default
       version's directory. A page under capabilities/ carries
       capability = true. */ -}}
{{- $root := "bundles/enhancements/edge" -}}
{{- $mres := resources.Get (printf "%s/manifest.json" $root) -}}
{{- if not $mres -}}{{- errorf "enhancements: %s/manifest.json is not mounted" $root -}}{{- end -}}
{{- $m := $mres | transform.Unmarshal -}}
{{- $dres := resources.Get (printf "%s/data/enhancements.json" $root) -}}
{{- if not $dres -}}{{- errorf "enhancements: %s/data/enhancements.json is not mounted" $root -}}{{- end -}}
{{- $data := $dres | transform.Unmarshal -}}
{{- $entryOf := dict -}}
{{- $docOf := dict -}}
{{- range $data.entries -}}
  {{- $e := . -}}
  {{- $entryOf = merge $entryOf (dict .page $e) -}}
  {{- range .documents -}}
    {{- $entryOf = merge $entryOf (dict .page $e) -}}
    {{- $docOf = merge $docOf (dict .page .) -}}
  {{- end -}}
{{- end -}}
{{- $retiredOf := dict -}}
{{- range $data.entries -}}
  {{- range .aliases -}}
    {{- $retiredOf = merge $retiredOf (dict .to (append .from (index $retiredOf .to | default slice))) -}}
  {{- end -}}
{{- end -}}
{{- range $m.pages -}}
  {{- if eq .path "_index.md" -}}{{ continue }}{{- end -}}
  {{- $pg := . -}}
  {{- $at := printf "enhancements bundle: content/%s" .path -}}
  {{- $f := resources.Get (printf "%s/content/%s" $root .path) -}}
  {{- if not $f -}}{{- errorf "%s: manifest.json lists it, but the bundle does not hold it" $at -}}{{- end -}}
  {{- $parts := findRESubmatch `(?s)\A---\n(.*?)\n---\n?(.*)\z` $f.Content 1 -}}
  {{- if not $parts -}}{{- errorf "%s: front matter must open on line 1 with --- and close with ---" $at -}}{{- end -}}
  {{- $fm := index (index $parts 0) 1 | transform.Unmarshal -}}
  {{- $body := index (index $parts 0) 2 -}}
  {{- $p := strings.TrimSuffix ".md" (strings.TrimSuffix "/_index.md" .path) -}}
  {{- $isSection := strings.HasSuffix .path "/_index.md" -}}
  {{- $page := dict
    "path" $p "kind" (cond $isSection "section" "page") "url" (printf "/enhancements/%s/" $p)
    "title" $fm.title "description" $fm.description "sitemap" (dict "disable" true) -}}
  {{- with $fm.weight -}}{{- $page = merge $page (dict "weight" .) -}}{{- end -}}
  {{- $params := dict "llms" false "repoPath" (.source | default "") -}}
  {{- with index $entryOf $p -}}
    {{- $e := . -}}
    {{- $by := slice -}}
    {{- with $e.supersededBy -}}{{- if reflect.IsSlice . -}}{{- $by = . -}}{{- else -}}{{- $by = slice . -}}{{- end -}}{{- end -}}
    {{- $params = merge $params (dict "enhId" $e.id "layout" ($e.layout | default "legacy") "status" $e.status "category" $e.category
        "affects" $e.affects "created" $e.created "updated" $e.updated "archived" $e.archived
        "dependsOn" $e.dependsOn "amends" $e.amends "supersedes" $e.supersedes "revives" $e.revives
        "supersededBy" $by "after" ($e.after | default slice) "capabilities" ($e.capabilities | default slice)) -}}
    {{- with $data.repo -}}{{- $params = merge $params (dict "repo" .) -}}{{- end -}}
    {{- with $e.accepted -}}{{- $params = merge $params (dict "accepted" .) -}}{{- end -}}
    {{- with $e.progress -}}{{- $params = merge $params (dict "progressDone" (int .done) "progressTotal" (int .total)) -}}{{- end -}}
    {{- $b := index $e "breaking" -}}
    {{- if eq (printf "%T" $b) "bool" -}}{{- $params = merge $params (dict "breaking" (cond $b "yes" "no")) -}}{{- end -}}
    {{- with index $docOf $p -}}
      {{- $params = merge $params (dict "document" .title) -}}
      {{- $page = merge $page (dict "linkTitle" .title) -}}
    {{- end -}}
  {{- else -}}
    {{- if findRE `^[0-9]{4}(/|$)` $p -}}
      {{- errorf "%s: data/enhancements.json has no entry for the page %s" $at $p -}}
    {{- end -}}
  {{- end -}}
  {{- with index $retiredOf $p -}}{{- $params = merge $params (dict "retired" .) -}}{{- end -}}
  {{- if or (eq $p "capabilities") (strings.HasPrefix $p "capabilities/") -}}{{- $params = merge $params (dict "capability" true) -}}{{- end -}}
  {{- $dates := dict -}}
  {{- with index $entryOf $p -}}
    {{- $dates = dict "date" (time.AsTime .created) "lastmod" (time.AsTime (cond $isSection .updated ($pg.lastmod | default .updated))) -}}
  {{- end -}}
  {{- $page = merge $page (dict "dates" $dates "params" $params
    "content" (dict "mediaType" "text/markdown" "value" $body)) -}}
  {{- $.AddPage $page -}}
{{- end -}}
