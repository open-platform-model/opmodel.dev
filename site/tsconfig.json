{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // Pages collected from other repositories import site components by this
    // alias; a relative path would break when the page is staged elsewhere.
    "paths": {
      "@components/*": ["./src/components/*"]
    }
  }
}
